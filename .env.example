# DopaMenu Environment Variables
# Copy this to .env and add your own keys

# PostHog Analytics (https://app.posthog.com)
POSTHOG_API_KEY=phc_YOUR_API_KEY_HERE
POSTHOG_HOST=https://app.posthog.com

# Calendar OAuth
GOOGLE_CALENDAR_IOS_CLIENT_ID=
GOOGLE_CALENDAR_ANDROID_CLIENT_ID=
GOOGLE_CALENDAR_WEB_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_ID=
CALENDAR_OAUTH_REDIRECT_URI=dopamenu://oauthredirect
